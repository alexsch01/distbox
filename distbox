#!/bin/bash

DISTBOX_IMAGE=registry.fedoraproject.org/fedora-toolbox:latest

DISTBOX_FILES=$HOME/distbox-files
DISTBOX_PODMAN_HOME=$DISTBOX_FILES/podman-files
DISTBOX_HOME=$DISTBOX_FILES/HOME

if [[ ! -v XAUTHORITY ]]; then
    XAUTHORITY=$HOME/.Xauthority
fi

dbus_setup() {
    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox rm -f /run/dbus/pid
    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox rm -f $XDG_RUNTIME_DIR/bus
    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox dbus-daemon --system
    HOME=$DISTBOX_PODMAN_HOME podman exec --user=$USER my-distbox dbus-daemon --session --address=unix:path=$XDG_RUNTIME_DIR/bus 2> /dev/null &

    until HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox test -S $XDG_RUNTIME_DIR/bus; do
        sleep 1
    done

    HOME=$DISTBOX_PODMAN_HOME podman exec \
        --user=$USER \
        --env XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR \
        my-distbox \
        dbus-update-activation-environment XDG_RUNTIME_DIR
}

if [ "$1" = "install" ]; then
    read -r -p "Do you want to install/replace your distbox? [y/N] " response
    if ! [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
        exit
    fi

    echo y | distbox uninstall

    mkdir -p $DISTBOX_PODMAN_HOME/.config/containers $DISTBOX_HOME
    touch $DISTBOX_PODMAN_HOME/THERE_ARE_FILES_HERE

    echo '[storage]
driver = "overlay"
graphroot = "$HOME/.local/share/containers/storage"
runroot = "$HOME/.config/containers/storage"' > $DISTBOX_PODMAN_HOME/.config/containers/storage.conf

    ln -sf $XAUTHORITY $XDG_RUNTIME_DIR/distbox-X11

    HOME=$DISTBOX_PODMAN_HOME podman create \
        --hostname $HOSTNAME \
        --name my-distbox \
        --privileged \
        --security-opt label=disable \
        --security-opt apparmor=unconfined \
        --pids-limit=-1 \
        --user root:root \
        --shm-size $(df -h /dev/shm | awk '{ print $2 }' | sed -n 2p) \
        --network host \
        --env USER=$USER \
        --env SHELL=bash \
        --env HOME=/home/$USER \
        --volume $DISTBOX_HOME:/home/$USER:rw \
        --volume $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:ro \
        --volume $XDG_RUNTIME_DIR/pipewire-0:$XDG_RUNTIME_DIR/pipewire-0:ro \
        --volume $XDG_RUNTIME_DIR/distbox-X11:$XDG_RUNTIME_DIR/distbox-X11:ro \
        --annotation run.oci.keep_original_groups=1 \
        --ulimit host \
        --userns keep-id \
        --entrypoint '["/bin/sh", "-c", "test -f /etc/sudoers.d/$USER || (echo \"$USER ALL=(ALL) NOPASSWD: ALL\" > /etc/sudoers.d/$USER && chmod 0440 /etc/sudoers.d/$USER); trap \"exit 0\" TERM; sleep infinity & wait"]' \
        $DISTBOX_IMAGE -- '' || exit

    HOME=$DISTBOX_PODMAN_HOME podman start my-distbox
    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox dnf install -y google-noto-color-emoji-fonts google-noto-sans-mono-fonts google-noto-sans-symbols2-fonts \
        dbus-daemon libglvnd-gles gsettings-desktop-schemas dconf

    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox chown $USER: $XDG_RUNTIME_DIR

    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox mkdir /run/dbus
    dbus_setup
    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox rm -f /etc/machine-id
    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox dbus-uuidgen --ensure=/etc/machine-id

    HOME=$DISTBOX_PODMAN_HOME podman exec --user=$USER my-distbox cp /etc/skel/.bashrc $HOME
    HOME=$DISTBOX_PODMAN_HOME podman exec --user=$USER my-distbox bash -c 'echo "export PS1=\"📦[\u@my-distbox \W]\$ \"" >> $HOME/.bashrc'
    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox bash -c 'echo "export PS1=\"📦[\u@my-distbox \W]# \"" >> /root/.bashrc'

    distbox run gsettings set org.gnome.desktop.wm.preferences button-layout ":minimize,maximize,close"
    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox pkill dconf-service
    HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox bash -c 'echo "exclude=*.i686" >> /etc/dnf/dnf.conf'
elif [ "$1" = "run" ]; then
    if [ "$(readlink -f $XDG_RUNTIME_DIR/distbox-X11)" != "$XAUTHORITY" ]; then
        echo y | distbox stop > /dev/null
        ln -sf $XAUTHORITY $XDG_RUNTIME_DIR/distbox-X11
    fi

    DISTBOX_OFFLINE=$(HOME=$DISTBOX_PODMAN_HOME podman exec my-distbox echo 2>&1)
    if [ "$DISTBOX_OFFLINE" == "Error: can only create exec sessions on running containers: container state improper" ]; then
        HOME=$DISTBOX_PODMAN_HOME podman start my-distbox > /dev/null
        dbus_setup
    fi

    HOME=$DISTBOX_PODMAN_HOME podman exec \
        --interactive \
        --detach-keys= \
        --user=root \
        --tty \
        --workdir=/home/$USER \
        --env HISTCONTROL=ignoredups \
        --env HISTSIZE=1000 \
        --env XDG_SESSION_TYPE=$XDG_SESSION_TYPE \
        --env LANG=$LANG \
        --env DISPLAY=$DISPLAY \
        --env XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR \
        --env TZ=$(timedatectl show --va -p Timezone) \
        --env DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus \
        --env WAYLAND_DISPLAY=$WAYLAND_DISPLAY \
    my-distbox \
        su --pty $USER -c "XAUTHORITY=$XDG_RUNTIME_DIR/distbox-X11 ${*: 2}"
elif [ "$1" = "enter" ]; then
    distbox run bash
elif [ "$1" = "stop" ]; then
    read -r -p "Do you want to stop your distbox? [y/N] " response
    if ! [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
        exit
    fi

    HOME=$DISTBOX_PODMAN_HOME podman stop my-distbox
elif [ "$1" = "uninstall" ]; then
    read -r -p "Do you want to uninstall your distbox? [y/N] " response
    if ! [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
        exit
    fi

    echo y | distbox stop > /dev/null 2>&1

    HOME=$DISTBOX_PODMAN_HOME podman unshare chown root: -R $DISTBOX_PODMAN_HOME/.local/share/containers/storage 2> /dev/null
    HOME=$DISTBOX_PODMAN_HOME podman unshare rm -rf $DISTBOX_PODMAN_HOME 2> /dev/null
    chmod -R +w $DISTBOX_FILES 2> /dev/null
    rm -rf $DISTBOX_FILES
else
    echo $'Valid commands: \n'
    echo 'distbox install'
    echo 'distbox run COMMAND'
    echo 'distbox enter'
    echo 'distbox stop'
    echo 'distbox uninstall'
fi
